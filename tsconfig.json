{
	"compilerOptions": {
		"module": "ESNext",
		"types": ["vite/client"],
		"composite": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@images/*": ["./src/assets/images/*"],
			"@config/*": ["./config/*"]
		},
		"moduleResolution": "Bundler"
	},
	"include": [
		"env.d.ts",
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.tsx",
		"src/**/*.vue",
		"config/*.json",
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*",
		"postcss.config.cjs"
	],
	"exclude": ["node_modules"]
}
